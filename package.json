{
  "name": "personal-system-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "npm run content && astro dev --host 127.0.0.1",
    "check": "npm run content && astro check",
    "build": "npm run content && astro build && node scripts/check-links.mjs",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "7.3.5",
    "@astrojs/starlight": "0.42.5",
    "@astrojs/markdown-remark": "7.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
